{
  "name": "pi-stash",
  "version": "0.1.0",
  "description": "Pi extension to stash and unstash typed prompts with cmd+shift+c and fuzzy search with cmd+shift+l",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "prompt-stash"
  ],
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/stash.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1 <2",
    "@earendil-works/pi-coding-agent": ">=0.85.1 <2",
    "@earendil-works/pi-tui": ">=0.85.1 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
